# Firebase values normally come from AppConfig.yml. These environment variables
# are optional local overrides.
# FIREBASE_APP_ID=1:205173771414:ios:replace-with-firebase-app-id
# FIREBASE_PROJECT_NUMBER=205173771414
# FIREBASE_GROUPS=internal
# FIREBASE_RELEASE_NOTES=Optional release notes override

# Shared Apple authentication belongs in the toolkit-root .env. Keep only
# app-specific Firebase and release overrides in this file.
